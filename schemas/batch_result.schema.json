{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batch QA Result",
  "type": "object",
  "required": [
    "generated_at",
    "station_filter",
    "processed_count",
    "passed_count",
    "failed_count",
    "results"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "station_filter": {
      "type": [
        "string",
        "null"
      ]
    },
    "processed_count": {
      "type": "integer",
      "minimum": 0
    },
    "passed_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "station",
          "verdict",
          "errors"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "station": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
